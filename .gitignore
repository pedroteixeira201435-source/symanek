# deps / builds
node_modules/
dist/
.next/
out/
build/
*.tsbuildinfo

# env & secrets — NEVER commit (keep .env.example)
.env
.env.*
!.env.example

# supabase local artifacts
supabase/.temp/
supabase/.branches/
supabase/.env

# student login credentials produced by the import script — NEVER commit
supabase/import/students_credentials.csv

# deploy secrets (DB url, service-role key) — NEVER commit
supabase/.env.deploy

# logs / os
*.log
.DS_Store
/tmp/
.vercel
.env*

# logical DB dumps — contain PII, never commit
supabase/backups/dumps/

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# student import: real input files and per-run results (PII + temp passwords) — NEVER commit
supabase/import/entrada/
supabase/import/saida/

# credential handouts — plaintext student/staff temp passwords, NEVER commit
PARA-A-CLIENTE/*STUDENT-LOGINS*
supabase/import/*credentials*.csv

# agent tooling generated by `ruflo init` (ex claude-flow) — boilerplate, not project config.
# .claude/settings.json only wires hooks into .claude/helpers/, which is generated too.
.agents/
.swarm/
.claude-flow/
agentdb.rvf
agentdb.rvf.lock
.mcp.json
.claude/settings.json
.claude/settings.local.json
.claude/commands/
.claude/helpers/
.claude/skills/
.claude/agents/*/
# keep the one agent that is actually this project's
!.claude/agents/symanek-integration-validator.md
